# Папка с исходными xlsx партнёра (внутри ищутся подпапки IEK и Systeme electric)
DATA_DIR=../../docs-hackalem/docs
# База проекта — SQLite. Путь к файлу относительно рабочей директории backend.
DATABASE_URL=sqlite:///./var/hackalem.db
# Куда складываются файлы экспорта
EXPORT_DIR=./var/exports
# Origins фронтенда через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
