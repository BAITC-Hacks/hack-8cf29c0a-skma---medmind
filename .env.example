# Optional Docker Compose settings. Copy to .env in the repository root.
APP_PORT=8080
# Load bundled demo data into an empty database on startup.
SEED_ON_START=true
# Only required for the AI assistant; never put this key in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL=gpt-6-sol
OPENAI_MODEL_DEEP=gpt-6-astra
